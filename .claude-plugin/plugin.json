{
  "name": "clocknext",
  "version": "0.1.0",
  "description": "Meter usage and manage usage-based billing from AI coding tools via the ClockNext API.",
  "author": { "name": "ClockNext", "email": "dev@clocknext.com" },
  "homepage": "https://github.com/ClockNext/clocknext-mcp",
  "repository": "https://github.com/ClockNext/clocknext-mcp",
  "license": "MIT",
  "keywords": ["clocknext", "billing", "metering", "usage-based-billing", "mcp"],
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "ClockNext API key",
      "description": "Your organisation's cnk_… key (Settings → API Keys). Stored securely.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "clocknext": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/index.js"],
      "env": {
        "CLOCKNEXT_API_KEY": "${user_config.api_key}"
      }
    }
  }
}
